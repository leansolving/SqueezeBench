import SqueezeBench.Problems.Roth.Records.Lower.V008.Def

/-! Record V009 for Roth, lower direction, by trial claude-fable: the record function.
The V008 closure enlarged in three ways and tabulated to `n ≤ 10000`: 88 new explicit 3-AP-free
sets at `215 ≤ n ≤ 2783`, found by concatenating two known extremal sets with the smallest shift
that creates no progression across the two parts (a search outside Lean; `Proof.lean` certifies
each set), and two more alphabets for the modular product rule, `D85` (17 residues modulo 85)
and `D65` (14 residues modulo 65), found by a constraint solver. Every entry of the table is
again certified by naming the rule or set that produces it. Above the table a tree recursion
applies the balanced split and the three modular products to the table's values. -/

namespace SqueezeBench.Roth.Lower.V009

/-- The closure table for `n = 0, …, 10000`: entry `n` sits at bits `12n … 12n + 11`. Every entry
is a lower bound on `r₃(n)` certified in `Proof.lean`. -/
def tab : ℕ :=
  

/-- Entry `n` of the table, `0` beyond it: a shift and a mask on a literal. -/
def get (n : ℕ) : ℕ := (tab >>> (12 * n)) &&& 4095

/-- 17 residues modulo 85 with no solution of `x + z ≡ 2y (mod 85)` other than `x = y = z`;
`17 > 85^{log 2 / log 3}`, so this alphabet beats the base-3 digits. -/
def D85 : List ℕ := [0, 5, 6, 8, 9, 21, 28, 44, 52, 54, 58, 63, 65, 66, 70, 81, 84]

/-- 14 residues modulo 65 with the same property. -/
def D65 : List ℕ := [0, 6, 8, 14, 18, 34, 38, 44, 46, 52, 53, 56, 61, 64]

/-- The recursion above the table: the best of the balanced base-3 split and the modular
products with `D37`, `D85` and `D65`, bottoming out on the table for `n ≤ 10000` and kept
monotone by carrying `get 10000` upwards. Structural in the fuel, so the kernel evaluates it. -/
def cntAux : ℕ → ℕ → ℕ
  | 0, _ => 0
  | fuel + 1, n =>
      if n ≤ 10000 then get n
      else max (max (get 10000) (cntAux fuel ((n + 2) / 3) + cntAux fuel ((n + 1) / 3)))
        (max (max (SqueezeBench.Roth.Lower.V008.D37.map (fun d => cntAux fuel ((n - d + 36) / 37))).sum
            (D85.map (fun d => cntAux fuel ((n - d + 84) / 85))).sum)
          (D65.map (fun d => cntAux fuel ((n - d + 64) / 65))).sum)

def cnt : SqueezeBench.BoundFn := fun n => cntAux n n

def record : SqueezeBench.BoundFn := SqueezeBench.maxWith SqueezeBench.Roth.Lower.V008.record cnt

end SqueezeBench.Roth.Lower.V009
