/-- The `k` 12-bit digits of `D`, lowest first. -/
def unpack : ℕ → ℕ → List ℕ
  | 0, _ => []
  | k + 1, D => (D &&& 4095) :: unpack k (D >>> 12)

/-- The set a triple stands for. -/
def setOf (p : ℕ × ℕ × ℕ) : List ℕ := unpack p.2.1 p.2.2

/-- The bitmask of a list: bit `x` is set for each `x` in the list. -/
def mask : List ℕ → ℕ
  | [] => 0
  | x :: l => (1 <<< x) ||| mask l

theorem testBit_mask : ∀ (l : List ℕ) (i : ℕ), (mask l).testBit i = true ↔ i ∈ l
  | [], i => by simp [mask]
  | x :: l, i => by
    rw [mask, Nat.testBit_lor, Nat.one_shiftLeft, Nat.testBit_two_pow, Bool.or_eq_true,
      decide_eq_true_eq, testBit_mask l i, List.mem_cons]
    constructor
    · rintro (rfl | h)
      · exact Or.inl rfl
      · exact Or.inr h
    · rintro (rfl | h)
      · exact Or.inl rfl
      · exact Or.inr h

/-- Strictly increasing, checked in linear time. -/
def sorted : List ℕ → Bool
  | [] => true
  | [_] => true
  | a :: b :: l => decide (a < b) && sorted (b :: l)

theorem sorted_pairwise : ∀ l : List ℕ, sorted l = true → l.Pairwise (· < ·)
  | [], _ => List.Pairwise.nil
  | [a], _ => by simp
  | a :: b :: l, h => by
    rw [sorted, Bool.and_eq_true, decide_eq_true_eq] at h
    have ih := sorted_pairwise (b :: l) h.2
    refine List.Pairwise.cons ?_ ih
    intro x hx
    rw [List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact h.1
    · exact lt_trans h.1 (List.rel_of_pairwise_cons ih hx)

theorem sorted_nodup {l : List ℕ} (h : sorted l = true) : l.Nodup :=
  (sorted_pairwise l h).imp (fun h => Nat.ne_of_lt h)

/-- The linear 3-AP check. With `M` the mask of `l` and `R` its mirror image in `[0, N)`, the
set `2b - l` is `R` shifted so that bit `y` of the shift is bit `2b - y` of `M`; the progressions
through `b` are then the common bits of `M` and the shift, which must be `b` alone. One shift, one
mask and one comparison per element, on literals. -/
def chk2 (l : List ℕ) (N : ℕ) : Bool :=
  let M := mask l
  let R := mask (l.map (fun x => N - 1 - x))
  l.all (fun x => decide (x < N)) &&
  l.all (fun b => decide ((if 2 * b + 1 ≤ N then M &&& (R >>> (N - 1 - 2 * b))
    else M &&& (R <<< (2 * b + 1 - N))) = 1 <<< b))

-- a progression `a, b, c` with `a ≠ c` would put bit `a` into `M &&& shift` for `b`
theorem free_of_chk2 {l : List ℕ} {N : ℕ} (h : chk2 l N = true) :
    ∀ a ∈ l, ∀ b ∈ l, ∀ c ∈ l, a + c = b + b → a = c := by
  simp only [chk2, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  obtain ⟨hlt, hb⟩ := h
  intro a ha b hb' c hc habc
  by_contra hne
  have hab : a ≠ b := by omega
  have hE := hb b hb'
  have hc' : c < N := hlt c hc
  have ha' : a < N := hlt a ha
  have hR : (mask (l.map (fun x => N - 1 - x))).testBit (N - 1 - c) = true := by
    rw [testBit_mask]; exact List.mem_map.2 ⟨c, hc, rfl⟩
  have hM : (mask l).testBit a = true := (testBit_mask l a).2 ha
  split_ifs at hE with h2b
  · have := congrArg (fun m => m.testBit a) hE
    simp only [Nat.testBit_land, Nat.testBit_shiftRight, Nat.one_shiftLeft,
      Nat.testBit_two_pow] at this
    have e : N - 1 - 2 * b + a = N - 1 - c := by omega
    rw [e, hR, hM] at this
    simp at this
    omega
  · have := congrArg (fun m => m.testBit a) hE
    simp only [Nat.testBit_land, Nat.testBit_shiftLeft, Nat.one_shiftLeft,
      Nat.testBit_two_pow] at this
    have e1 : a ≥ 2 * b + 1 - N := by omega
    have e2 : a - (2 * b + 1 - N) = N - 1 - c := by omega
    rw [e2, hR, hM] at this
    simp [e1] at this
    omega

/-- Every set is sorted (hence duplicate-free) and passes the 3-AP check inside `[0, n)`. -/
def certOK : Bool := certs.all (fun p => sorted (setOf p) && chk2 (setOf p) p.1)

theorem certOK_eq : certOK = true := by decide +kernel

theorem certs_le : ∀ p ∈ certs, ∀ n,
    SqueezeBench.Roth.Lower.V004.below (setOf p) n ≤ SqueezeBench.Roth.f n := by
  have h := certOK_eq
  simp only [certOK, List.all_eq_true, Bool.and_eq_true] at h
  intro p hp n
  obtain ⟨hs, hc⟩ := h p hp
  exact SqueezeBench.Roth.Lower.V004.below_le (setOf p) (sorted_nodup hs) (free_of_chk2 hc) n

theorem getD_mem_or {α : Type} : ∀ (l : List α) (i : ℕ) (d : α), l.getD i d = d ∨ l.getD i d ∈ l
  | [], _, _ => Or.inl rfl
  | x :: _, 0, _ => Or.inr (List.mem_cons_self ..)
  | x :: l, i + 1, d => by
    have e : (x :: l).getD (i + 1) d = l.getD i d := rfl
    rw [e]
    rcases getD_mem_or l i d with h | h
    · exact Or.inl h
    · exact Or.inr (List.mem_cons_of_mem x h)

/-! ## The modular product for any alphabet -/

-- `⋃_{d ∈ D} (q·A_d + d) ⊆ [0, n)` is 3-AP-free for 3-AP-free `A_d ⊆ [0, ⌈(n-d)/q⌉)`: reducing
-- `x + z = 2y` modulo `q` forces equal last digits, so a progression lies in one `q·A_d + d`
theorem modular_le (q : ℕ) (hq : 0 < q) (D : List ℕ) (hD : D.Nodup) (hDq : ∀ d ∈ D, d < q)
    (hfree : ∀ x ∈ D, ∀ y ∈ D, ∀ z ∈ D, (x + z) % q = (2 * y) % q → x = y ∧ y = z) (n : ℕ) :
    (D.map (fun d => SqueezeBench.Roth.f ((n - d + (q - 1)) / q))).sum ≤ SqueezeBench.Roth.f n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have h0 : ∀ d ∈ D, SqueezeBench.Roth.f ((0 - d + (q - 1)) / q) = 0 := by
      intro d _
      have : (0 - d + (q - 1)) / q = 0 := by
        apply Nat.div_eq_of_lt; omega
      rw [this]; simp [SqueezeBench.Roth.f]
    have : (D.map (fun d => SqueezeBench.Roth.f ((0 - d + (q - 1)) / q))).sum = 0 := by
      rw [List.sum_eq_zero]
      intro x hx
      obtain ⟨d, hd, rfl⟩ := List.mem_map.1 hx
      exact h0 d hd
    rw [this]; exact Nat.zero_le _
  have hspec : ∀ d : ℕ, ∃ t : Finset ℕ, t ⊆ range ((n - d + (q - 1)) / q) ∧
      t.card = rothNumberNat ((n - d + (q - 1)) / q) ∧ ThreeAPFree (t : Set ℕ) :=
    fun d => rothNumberNat_spec _
  choose A hAsub hAcard hAfree using hspec
  have hA' : ∀ d, ∀ x ∈ A d, x < (n - d + (q - 1)) / q :=
    fun d x hx => mem_range.1 (hAsub d hx)
  have hinj : ∀ d, Function.Injective (fun x : ℕ => q * x + d) := by
    intro d x y h
    dsimp only at h
    exact Nat.eq_of_mul_eq_mul_left hq (Nat.add_right_cancel h)
  have hres : ∀ x d, d < q → (q * x + d) % q = d := by
    intro x d hd
    rw [Nat.mul_add_mod, Nat.mod_eq_of_lt hd]
  set S : Finset ℕ := D.toFinset.biUnion (fun d => (A d).image (fun x => q * x + d)) with hSdef
  have hmem : ∀ x ∈ S, ∃ d ∈ D, ∃ a ∈ A d, x = q * a + d := by
    intro x hx
    simp only [hSdef, mem_biUnion, List.mem_toFinset, mem_image] at hx
    obtain ⟨d, hd, a, ha, rfl⟩ := hx
    exact ⟨d, hd, a, ha, rfl⟩
  have hdisj : (↑D.toFinset : Set ℕ).PairwiseDisjoint
      (fun d => (A d).image (fun x => q * x + d)) := by
    intro d hd d' hd' hne
    rw [Function.onFun, Finset.disjoint_left]
    intro x hx hx'
    simp only [mem_image] at hx hx'
    obtain ⟨a, _, rfl⟩ := hx
    obtain ⟨a', _, h⟩ := hx'
    have h1 := hres a d (hDq d (by simpa using hd))
    have h2 := hres a' d' (hDq d' (by simpa using hd'))
    rw [h] at h2
    exact hne (h1.symm.trans h2)
  have hcard : S.card = (D.map (fun d => (A d).card)).sum := by
    rw [hSdef, card_biUnion hdisj, ← List.sum_toFinset _ hD]
    refine Finset.sum_congr rfl ?_
    intro d _
    exact card_image_of_injective _ (hinj d)
  have hlt : ∀ x ∈ S, x < n := by
    intro x hx
    obtain ⟨d, hd, a, ha, rfl⟩ := hmem x hx
    have h1 := hA' d a ha
    have h2 : (a + 1) * q ≤ n - d + (q - 1) := (Nat.le_div_iff_mul_le hq).1 h1
    have h3 : (a + 1) * q = a * q + q := Nat.succ_mul a q
    have h4 : q * a = a * q := Nat.mul_comm q a
    omega
  have hfreeS : ThreeAPFree (S : Set ℕ) := by
    intro x hx y hy z hz h
    obtain ⟨d₁, hd₁, a, ha, rfl⟩ := hmem x (mem_coe.1 hx)
    obtain ⟨d₂, hd₂, b, hb, rfl⟩ := hmem y (mem_coe.1 hy)
    obtain ⟨d₃, hd₃, c, hc, rfl⟩ := hmem z (mem_coe.1 hz)
    have e1 : q * a + d₁ + (q * c + d₃) = q * (a + c) + (d₁ + d₃) := by ring
    have e2 : q * b + d₂ + (q * b + d₂) = q * (b + b) + 2 * d₂ := by ring
    have hmod : (d₁ + d₃) % q = (2 * d₂) % q := by
      rw [← Nat.mul_add_mod q (a + c) (d₁ + d₃), ← Nat.mul_add_mod q (b + b) (2 * d₂), ← e1,
        ← e2, h]
    obtain ⟨rfl, rfl⟩ := hfree d₁ hd₁ d₂ hd₂ d₃ hd₃ hmod
    have e3 : q * (a + c) = q * a + q * c := Nat.mul_add q a c
    have e4 : q * (b + b) = q * b + q * b := Nat.mul_add q b b
    have habc : a + c = b + b := Nat.eq_of_mul_eq_mul_left hq (by omega)
    have := hAfree d₁ (mem_coe.2 ha) (mem_coe.2 hb) (mem_coe.2 hc) habc
    subst this
    rfl
  have hkey : (D.map (fun d => (A d).card)).sum ≤ SqueezeBench.Roth.f n :=
    SqueezeBench.Roth.le_f_of_threeAPFree (by simp; omega) S hfreeS hlt hcard
  refine le_trans (List.sum_le_sum ?_) hkey
  intro d _
  rw [hAcard d]
  exact SqueezeBench.Roth.Lower.V008.f_le_roth _

theorem D85_free : ∀ x ∈ D85, ∀ y ∈ D85, ∀ z ∈ D85,
    (x + z) % 85 = (2 * y) % 85 → x = y ∧ y = z := by decide +kernel

theorem D65_free : ∀ x ∈ D65, ∀ y ∈ D65, ∀ z ∈ D65,
    (x + z) % 65 = (2 * y) % 65 → x = y ∧ y = z := by decide +kernel

theorem mod37_le (n : ℕ) :
    (SqueezeBench.Roth.Lower.V008.D37.map (fun d => SqueezeBench.Roth.f ((n - d + 36) / 37))).sum
      ≤ SqueezeBench.Roth.f n :=
  SqueezeBench.Roth.Lower.V008.mod37_le n

theorem mod85_le (n : ℕ) :
    (D85.map (fun d => SqueezeBench.Roth.f ((n - d + 84) / 85))).sum ≤ SqueezeBench.Roth.f n :=
  modular_le 85 (by norm_num) D85 (by decide) (by decide) D85_free n

theorem mod65_le (n : ℕ) :
    (D65.map (fun d => SqueezeBench.Roth.f ((n - d + 64) / 65))).sum ≤ SqueezeBench.Roth.f n :=
  modular_le 65 (by norm_num) D65 (by decide) (by decide) D65_free n

/-! ## The table -/

/-- The certificate of each entry `n ≤ 10000`, 16 bits per `n`: `code n % 8` names the rule —
`0` the V007 table, `1` monotonicity, `2` the balanced split, `3` the modular product with the
alphabet `code n / 8` (`0` for `D37`, `1` for `D85`, `2` for `D65`), `4` concatenation with
`a = code n / 8`, `5` the explicit set of `certs[code n / 8]`. -/
def codes : ℕ :=
  

def code (n : ℕ) : ℕ := (codes >>> (16 * n)) &&& 65535

/-- The modular candidate at `n` for the alphabet `D` modulo `q`. -/
def modSum (q : ℕ) (D : List ℕ) (n : ℕ) : ℕ := (D.map (fun d => get ((n - d + (q - 1)) / q))).sum

/-- The value the rule named by `c` produces at `n`, or `0` when its side conditions fail. -/
def cand (n c : ℕ) : ℕ :=
  if c % 8 = 0 then SqueezeBench.Roth.Lower.V007.tbl n
  else if c % 8 = 1 then (if n = 0 then 0 else get (n - 1))
  else if c % 8 = 2 then (if n < 2 then 0 else get ((n + 2) / 3) + get ((n + 1) / 3))
  else if c % 8 = 3 then (if n < 2 then 0 else
    if c / 8 = 0 then modSum 37 SqueezeBench.Roth.Lower.V008.D37 n
    else if c / 8 = 1 then modSum 85 D85 n else modSum 65 D65 n)
  else if c % 8 = 4 then (if 1 ≤ c / 8 ∧ c / 8 ≤ (n + 1 - c / 8) / 2
    then get (c / 8) + get ((n + 1 - c / 8) / 2) else 0)
  else if c % 8 = 5 then SqueezeBench.Roth.Lower.V004.below (setOf (certs.getD (c / 8) (0, 0, 0))) n
  else 0

/-- Entries `m, …, m + k - 1` are at most their named candidates. -/
def checkAux : ℕ → ℕ → Bool
  | 0, _ => true
  | k + 1, m => decide (get m ≤ cand m (code m)) && checkAux k (m + 1)

theorem check_eq : checkAux 10001 0 = true := by decide +kernel

theorem checkAux_spec : ∀ k m, checkAux k m = true →
    ∀ n, m ≤ n → n < m + k → get n ≤ cand n (code n) := by
  intro k
  induction k with
  | zero => intro m _ n h1 h2; omega
  | succ k ih =>
    intro m h n h1 h2
    rw [checkAux] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact h.1
    · exact ih (m + 1) h.2 n (by omega) (by omega)

-- the modular candidate is bounded once all its inputs are
theorem modSum_le (q : ℕ) (D : List ℕ) (n : ℕ)
    (hD : (D.map (fun d => SqueezeBench.Roth.f ((n - d + (q - 1)) / q))).sum ≤ SqueezeBench.Roth.f n)
    (ih : ∀ d ∈ D, get ((n - d + (q - 1)) / q) ≤ SqueezeBench.Roth.f ((n - d + (q - 1)) / q)) :
    modSum q D n ≤ SqueezeBench.Roth.f n :=
  le_trans (List.sum_le_sum ih) hD

-- every table entry is a lower bound: strong induction on `n`, each certificate naming a rule
-- or a set whose inputs are earlier entries
theorem get_le : ∀ n, n ≤ 10000 → get n ≤ SqueezeBench.Roth.f n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro hn
  have hc := checkAux_spec 10001 0 check_eq n (Nat.zero_le _) (by omega)
  unfold cand at hc
  split_ifs at hc with h0 h1 hz h2 hlt2 h3 hlt3 hq0 hq1 h4 hab h5
  · exact le_trans hc (SqueezeBench.Roth.Lower.V007.tbl_le n)
  · exact le_trans hc (Nat.zero_le _)
  · exact le_trans hc (le_trans (ih (n - 1) (by omega) (by omega))
      (SqueezeBench.Roth.Lower.V008.f_mono' (by omega)))
  · exact le_trans hc (Nat.zero_le _)
  · have h₁ := ih ((n + 2) / 3) (by omega) (by omega)
    have h₂ := ih ((n + 1) / 3) (by omega) (by omega)
    have := SqueezeBench.Roth.Lower.V002.split_le n (by omega)
    omega
  · exact le_trans hc (Nat.zero_le _)
  · refine le_trans hc (modSum_le 37 _ n (mod37_le n) ?_)
    intro d _
    exact ih _ (by omega) (by omega)
  · refine le_trans hc (modSum_le 85 _ n (mod85_le n) ?_)
    intro d _
    exact ih _ (by omega) (by omega)
  · refine le_trans hc (modSum_le 65 _ n (mod65_le n) ?_)
    intro d _
    exact ih _ (by omega) (by omega)
  · have h₁ := ih (code n / 8) (by omega) (by omega)
    have h₂ := ih ((n + 1 - code n / 8) / 2) (by omega) (by omega)
    have := SqueezeBench.Roth.Lower.V008.cat_le (code n / 8) ((n + 1 - code n / 8) / 2) n hab.1
      hab.2 (by omega)
    omega
  · exact le_trans hc (Nat.zero_le _)
  · rcases getD_mem_or certs (code n / 8) (0, 0, 0) with h | h
    · rw [h] at hc
      exact le_trans hc (Nat.zero_le _)
    · exact le_trans hc (certs_le _ h n)
  · exact le_trans hc (Nat.zero_le _)

-- monotonicity of `f`: the top of the table survives to every larger `n`
theorem get10000_le {n : ℕ} (hn : 10000 ≤ n) : get 10000 ≤ SqueezeBench.Roth.f n :=
  le_trans (get_le 10000 le_rfl) (SqueezeBench.Roth.Lower.V008.f_mono' hn)

theorem cntAux_le : ∀ fuel n : ℕ, n ≤ fuel → cntAux fuel n ≤ SqueezeBench.Roth.f n := by
  intro fuel
  induction fuel with
  | zero =>
    intro n hn
    have : n = 0 := by omega
    subst this
    simp [cntAux, SqueezeBench.Roth.f]
  | succ fuel ih =>
    intro n hn
    rw [cntAux]
    split
    · exact get_le n (by omega)
    · rename_i h10000
      refine max_le (max_le (get10000_le (by omega)) ?_) (max_le (max_le ?_ ?_) ?_)
      · have h₁ := ih ((n + 2) / 3) (by omega)
        have h₂ := ih ((n + 1) / 3) (by omega)
        have := SqueezeBench.Roth.Lower.V002.split_le n (by omega)
        omega
      · refine le_trans (List.sum_le_sum ?_) (mod37_le n)
        intro d _
        exact ih ((n - d + 36) / 37) (by omega)
      · refine le_trans (List.sum_le_sum ?_) (mod85_le n)
        intro d _
        exact ih ((n - d + 84) / 85) (by omega)
      · refine le_trans (List.sum_le_sum ?_) (mod65_le n)
        intro d _
        exact ih ((n - d + 64) / 65) (by omega)

theorem cnt_valid : SqueezeBench.LowerBoundHolds SqueezeBench.Roth.f cnt :=
  fun n => cntAux_le n n le_rfl

theorem valid : SqueezeBench.LowerBoundHolds SqueezeBench.Roth.f record :=
  SqueezeBench.maxWith_valid SqueezeBench.Roth.Lower.V008.valid cnt_valid

theorem improves : SqueezeBench.ImprovesLower SqueezeBench.Roth.Lower.V008.record record :=
  SqueezeBench.maxWith_improves

theorem strict :
    SqueezeBench.StrictlyImprovesLower SqueezeBench.Roth.nMin SqueezeBench.Roth.Lower.V008.record record :=
  SqueezeBench.maxWith_strict (nMin := SqueezeBench.Roth.nMin) (n₀ := 8000) (by decide)
    (by decide +kernel)

end SqueezeBench.Roth.Lower.V009
