import SqueezeBench.Problems.Roth.Records.Lower.V007.Def

/-! Record V008 for Roth, lower direction, by trial claude-fable: the record function.
The closure of four sound rules over the exact table of V007, tabulated for `n ≤ 3000`:
monotonicity, the balanced last-digit split `f n ≥ f ⌈n/3⌉ + f ⌈(n-1)/3⌉`, concatenation with a
gap (`f n ≥ f a + f b` when `a ≤ b` and `a + 2b - 1 ≤ n`), and the modular product with the
ten-digit alphabet `D37` (3-AP-free modulo 37): `f n ≥ Σ_{d ∈ D37} f ⌈(n-d)/37⌉`. The table is a
single natural number with 16 bits per entry; `Proof.lean` certifies every entry by naming the
rule that produces it. Above the table, a tree recursion applies the balanced and the modular
rule to the table's values. -/

namespace SqueezeBench.Roth.Lower.V008

/-- The closure table for `n = 0, …, 3000`: entry `n` sits at bits `16n … 16n + 15`. Every entry
is a lower bound on `r₃(n)` certified in `Proof.lean` by a rule and its parameter. -/
def tab : ℕ :=
  

/-- Entry `n` of the table, `0` beyond it. Two kernel-accelerated operations on a literal. -/
def get (n : ℕ) : ℕ := (tab >>> (16 * n)) &&& 65535

/-- The digit alphabet of the modular rule: `x + z ≡ 2y (mod 37)` has no solution in `D37` other
than `x = y = z`. It is the block of the extremal set at `n = 174`, which is `D37 + 37·{0,1,3,4}`. -/
def D37 : List ℕ := [0, 1, 4, 6, 10, 15, 17, 18, 23, 25]

/-- The recursion above the table: the better of the balanced base-3 split and the modular
product with `D37`, bottoming out on the table for `n ≤ 3000` and kept monotone by carrying
`get 3000` upwards. Structural in the fuel, so the kernel evaluates it. -/
def cntAux : ℕ → ℕ → ℕ
  | 0, _ => 0
  | fuel + 1, n =>
      if n ≤ 3000 then get n
      else max (get 3000)
        (max (cntAux fuel ((n + 2) / 3) + cntAux fuel ((n + 1) / 3))
          (D37.map (fun d => cntAux fuel ((n - d + 36) / 37))).sum)

def cnt : SqueezeBench.BoundFn := fun n => cntAux n n

def record : SqueezeBench.BoundFn := SqueezeBench.maxWith SqueezeBench.Roth.Lower.V007.record cnt

end SqueezeBench.Roth.Lower.V008
