import SqueezeBench.Problems.Roth.Records.Lower.V008.Def
import SqueezeBench.Problems.Roth.Records.Lower.V007.Proof

/-! Record V008 for Roth, lower direction, by trial claude-fable: the three obligations.
Keep the statements as written; they are copied from
`Challenges/Roth/Lower/V008.lean`. -/

namespace SqueezeBench.Roth.Lower.V008

open SqueezeBench Finset

/-! ## The four rules -/

-- `f` is monotone from `0` on, since `f 0 = 0`
theorem f_mono' {m n : ℕ} (h : m ≤ n) : SqueezeBench.Roth.f m ≤ SqueezeBench.Roth.f n := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · simp [SqueezeBench.Roth.f]
  · exact SqueezeBench.Roth.f_mono (by simp; omega) h

theorem f_le_roth (k : ℕ) : SqueezeBench.Roth.f k ≤ rothNumberNat k := by
  unfold SqueezeBench.Roth.f
  split <;> simp

-- concatenation with a gap: `A ∪ (B + (a + b - 1)) ⊆ [0, a + 2b - 1)` is 3-AP-free for
-- 3-AP-free `A ⊆ [0, a)`, `B ⊆ [0, b)` with `a ≤ b`: a progression with two terms in one part and
-- one in the other is too long to fit
theorem cat_le (a b n : ℕ) (ha : 1 ≤ a) (hab : a ≤ b) (hn : a + 2 * b ≤ n + 1) :
    SqueezeBench.Roth.f a + SqueezeBench.Roth.f b ≤ SqueezeBench.Roth.f n := by
  obtain ⟨A, hAsub, hAcard, hAfree⟩ := rothNumberNat_spec a
  obtain ⟨B, hBsub, hBcard, hBfree⟩ := rothNumberNat_spec b
  have hinj : Function.Injective (fun x : ℕ => x + (a + b - 1)) := by
    intro x y h; dsimp only at h; omega
  have hA' : ∀ x ∈ A, x < a := fun x hx => mem_range.1 (hAsub hx)
  have hB' : ∀ x ∈ B, x < b := fun x hx => mem_range.1 (hBsub hx)
  set S : Finset ℕ := A ∪ B.image (fun x => x + (a + b - 1)) with hSdef
  have hdisj : Disjoint A (B.image (fun x => x + (a + b - 1))) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [mem_image] at hx'
    obtain ⟨y, hy, rfl⟩ := hx'
    have := hA' _ hx
    have := hB' y hy
    omega
  have hcard : S.card = A.card + B.card := by
    rw [hSdef, card_union_of_disjoint hdisj, card_image_of_injective _ hinj]
  have hmem : ∀ x ∈ S, (x < a ∧ x ∈ A) ∨
      (a + b - 1 ≤ x ∧ x < a + 2 * b - 1 ∧ x - (a + b - 1) ∈ B) := by
    intro x hx
    simp only [hSdef, mem_union, mem_image] at hx
    rcases hx with hx | ⟨y, hy, rfl⟩
    · exact Or.inl ⟨hA' x hx, hx⟩
    · have := hB' y hy
      refine Or.inr ⟨by omega, by omega, ?_⟩
      have h : y + (a + b - 1) - (a + b - 1) = y := by omega
      rw [h]; exact hy
  have hlt : ∀ x ∈ S, x < n := by
    intro x hx
    rcases hmem x hx with ⟨h, _⟩ | ⟨_, h, _⟩ <;> omega
  have hfree : ThreeAPFree (S : Set ℕ) := by
    intro x hx y hy z hz h
    have hx' := hmem x (mem_coe.1 hx)
    have hy' := hmem y (mem_coe.1 hy)
    have hz' := hmem z (mem_coe.1 hz)
    rcases hx' with ⟨hxa, hxA⟩ | ⟨hxs, hxb, hxB⟩ <;>
    rcases hy' with ⟨hya, hyA⟩ | ⟨hys, hyb, hyB⟩ <;>
    rcases hz' with ⟨hza, hzA⟩ | ⟨hzs, hzb, hzB⟩
    · exact hAfree (mem_coe.2 hxA) (mem_coe.2 hyA) (mem_coe.2 hzA) h
    · omega
    · omega
    · omega
    · omega
    · omega
    · omega
    · have := hBfree (mem_coe.2 hxB) (mem_coe.2 hyB) (mem_coe.2 hzB) (by omega)
      omega
  have hkey : A.card + B.card ≤ SqueezeBench.Roth.f n :=
    SqueezeBench.Roth.le_f_of_threeAPFree (by simp; omega) S hfree hlt hcard
  rw [SqueezeBench.Roth.f_of_le (show SqueezeBench.Roth.nMin ≤ a by simp; omega),
    SqueezeBench.Roth.f_of_le (show SqueezeBench.Roth.nMin ≤ b by simp; omega)]
  omega

-- the alphabet is 3-AP-free modulo 37 in the strong sense: a finite check of the `10³` triples
theorem D37_free : ∀ x ∈ D37, ∀ y ∈ D37, ∀ z ∈ D37,
    (x + z) % 37 = (2 * y) % 37 → x = y ∧ y = z := by decide +kernel

theorem D37_lt : ∀ d ∈ D37, d < 37 := by decide

theorem D37_nodup : D37.Nodup := by decide

-- the modular product: `⋃_{d ∈ D37} (37·A_d + d) ⊆ [0, n)` is 3-AP-free for 3-AP-free
-- `A_d ⊆ [0, ⌈(n-d)/37⌉)`: a progression has equal last digits, hence lies in one `37·A_d + d`
theorem mod37_le (n : ℕ) :
    (D37.map (fun d => SqueezeBench.Roth.f ((n - d + 36) / 37))).sum ≤ SqueezeBench.Roth.f n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [D37, SqueezeBench.Roth.f]
  have hspec : ∀ d : ℕ, ∃ t : Finset ℕ, t ⊆ range ((n - d + 36) / 37) ∧
      t.card = rothNumberNat ((n - d + 36) / 37) ∧ ThreeAPFree (t : Set ℕ) :=
    fun d => rothNumberNat_spec _
  choose A hAsub hAcard hAfree using hspec
  have hA' : ∀ d, ∀ x ∈ A d, x < (n - d + 36) / 37 := fun d x hx => mem_range.1 (hAsub d hx)
  have hinj : ∀ d, Function.Injective (fun x : ℕ => 37 * x + d) := by
    intro d x y h; dsimp only at h; omega
  set S : Finset ℕ := D37.toFinset.biUnion (fun d => (A d).image (fun x => 37 * x + d)) with hSdef
  have hmem : ∀ x ∈ S, ∃ d ∈ D37, ∃ a ∈ A d, x = 37 * a + d := by
    intro x hx
    simp only [hSdef, mem_biUnion, List.mem_toFinset, mem_image] at hx
    obtain ⟨d, hd, a, ha, rfl⟩ := hx
    exact ⟨d, hd, a, ha, rfl⟩
  have hdisj : (↑D37.toFinset : Set ℕ).PairwiseDisjoint
      (fun d => (A d).image (fun x => 37 * x + d)) := by
    intro d hd d' hd' hne
    rw [Function.onFun, Finset.disjoint_left]
    intro x hx hx'
    simp only [mem_image] at hx hx'
    obtain ⟨a, _, rfl⟩ := hx
    obtain ⟨a', _, h⟩ := hx'
    have := D37_lt d (by simpa using hd)
    have := D37_lt d' (by simpa using hd')
    omega
  have hcard : S.card = (D37.map (fun d => (A d).card)).sum := by
    rw [hSdef, card_biUnion hdisj, ← List.sum_toFinset _ D37_nodup]
    refine Finset.sum_congr rfl ?_
    intro d _
    exact card_image_of_injective _ (hinj d)
  have hlt : ∀ x ∈ S, x < n := by
    intro x hx
    obtain ⟨d, _, a, ha, rfl⟩ := hmem x hx
    have := hA' d a ha
    omega
  have hfree : ThreeAPFree (S : Set ℕ) := by
    intro x hx y hy z hz h
    obtain ⟨d₁, hd₁, a, ha, rfl⟩ := hmem x (mem_coe.1 hx)
    obtain ⟨d₂, hd₂, b, hb, rfl⟩ := hmem y (mem_coe.1 hy)
    obtain ⟨d₃, hd₃, c, hc, rfl⟩ := hmem z (mem_coe.1 hz)
    have hmod : (d₁ + d₃) % 37 = (2 * d₂) % 37 := by omega
    obtain ⟨rfl, rfl⟩ := D37_free d₁ hd₁ d₂ hd₂ d₃ hd₃ hmod
    have habc : a + c = b + b := by omega
    have := hAfree d₁ (mem_coe.2 ha) (mem_coe.2 hb) (mem_coe.2 hc) habc
    omega
  have hkey : (D37.map (fun d => (A d).card)).sum ≤ SqueezeBench.Roth.f n :=
    SqueezeBench.Roth.le_f_of_threeAPFree (by simp; omega) S hfree hlt hcard
  refine le_trans (List.sum_le_sum ?_) hkey
  intro d _
  rw [hAcard d]
  exact f_le_roth _

/-! ## The table -/

/-- The certificate of each entry `n ≤ 3000`, 16 bits per `n`: `code n % 4` names the rule —
`0` the V007 table, `1` monotonicity, `2` the balanced split, `3` the modular product when
`code n / 4 = 0` and otherwise concatenation with `a = code n / 4`. -/
def codes : ℕ :=
  

def code (n : ℕ) : ℕ := (codes >>> (16 * n)) &&& 65535

/-- The modular candidate at `n`. -/
def modSum (n : ℕ) : ℕ := (D37.map (fun d => get ((n - d + 36) / 37))).sum

/-- The value the rule named by `c` produces at `n`, or `0` when its side conditions fail. -/
def cand (n c : ℕ) : ℕ :=
  if c % 4 = 0 then SqueezeBench.Roth.Lower.V007.tbl n
  else if c % 4 = 1 then (if n = 0 then 0 else get (n - 1))
  else if c % 4 = 2 then (if n < 2 then 0 else get ((n + 2) / 3) + get ((n + 1) / 3))
  else if c / 4 = 0 then (if n < 2 then 0 else modSum n)
  else if c / 4 ≤ (n + 1 - c / 4) / 2 then get (c / 4) + get ((n + 1 - c / 4) / 2)
  else 0

/-- Entries `m, …, m + k - 1` are at most their named candidates. -/
def checkAux : ℕ → ℕ → Bool
  | 0, _ => true
  | k + 1, m => decide (get m ≤ cand m (code m)) && checkAux k (m + 1)

theorem check_eq : checkAux 3001 0 = true := by decide +kernel

theorem checkAux_spec : ∀ k m, checkAux k m = true →
    ∀ n, m ≤ n → n < m + k → get n ≤ cand n (code n) := by
  intro k
  induction k with
  | zero => intro m _ n h1 h2; omega
  | succ k ih =>
    intro m h n h1 h2
    rw [checkAux] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact h.1
    · exact ih (m + 1) h.2 n (by omega) (by omega)

-- every table entry is a lower bound: strong induction on `n`, each certificate naming a rule
-- whose inputs are earlier entries
theorem get_le : ∀ n, n ≤ 3000 → get n ≤ SqueezeBench.Roth.f n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro hn
  have hc := checkAux_spec 3001 0 check_eq n (Nat.zero_le _) (by omega)
  unfold cand at hc
  split_ifs at hc with h0 h1 hz h2 hlt2 h3 hlt2' h4
  · exact le_trans hc (SqueezeBench.Roth.Lower.V007.tbl_le n)
  · exact le_trans hc (Nat.zero_le _)
  · exact le_trans hc (le_trans (ih (n - 1) (by omega) (by omega)) (f_mono' (by omega)))
  · exact le_trans hc (Nat.zero_le _)
  · have h₁ := ih ((n + 2) / 3) (by omega) (by omega)
    have h₂ := ih ((n + 1) / 3) (by omega) (by omega)
    have := SqueezeBench.Roth.Lower.V002.split_le n (by omega)
    omega
  · exact le_trans hc (Nat.zero_le _)
  · refine le_trans hc (le_trans (List.sum_le_sum ?_) (mod37_le n))
    intro d _
    exact ih ((n - d + 36) / 37) (by omega) (by omega)
  · have ha : 1 ≤ code n / 4 := by omega
    have h₁ := ih (code n / 4) (by omega) (by omega)
    have h₂ := ih ((n + 1 - code n / 4) / 2) (by omega) (by omega)
    have := cat_le (code n / 4) ((n + 1 - code n / 4) / 2) n ha h4 (by omega)
    omega
  · exact le_trans hc (Nat.zero_le _)

-- monotonicity of `f`: the top of the table survives to every larger `n`
theorem get3000_le {n : ℕ} (hn : 3000 ≤ n) : get 3000 ≤ SqueezeBench.Roth.f n :=
  le_trans (get_le 3000 le_rfl) (f_mono' hn)

theorem cntAux_le : ∀ fuel n : ℕ, n ≤ fuel → cntAux fuel n ≤ SqueezeBench.Roth.f n := by
  intro fuel
  induction fuel with
  | zero =>
    intro n hn
    have : n = 0 := by omega
    subst this
    simp [cntAux, SqueezeBench.Roth.f]
  | succ fuel ih =>
    intro n hn
    rw [cntAux]
    split
    · exact get_le n (by omega)
    · rename_i h3000
      refine max_le (get3000_le (by omega)) (max_le ?_ ?_)
      · have h₁ := ih ((n + 2) / 3) (by omega)
        have h₂ := ih ((n + 1) / 3) (by omega)
        have := SqueezeBench.Roth.Lower.V002.split_le n (by omega)
        omega
      · refine le_trans (List.sum_le_sum ?_) (mod37_le n)
        intro d _
        exact ih ((n - d + 36) / 37) (by omega)

theorem cnt_valid : SqueezeBench.LowerBoundHolds SqueezeBench.Roth.f cnt :=
  fun n => cntAux_le n n le_rfl

theorem valid : SqueezeBench.LowerBoundHolds SqueezeBench.Roth.f record :=
  SqueezeBench.maxWith_valid SqueezeBench.Roth.Lower.V007.valid cnt_valid

theorem improves : SqueezeBench.ImprovesLower SqueezeBench.Roth.Lower.V007.record record :=
  SqueezeBench.maxWith_improves

theorem strict :
    SqueezeBench.StrictlyImprovesLower SqueezeBench.Roth.nMin SqueezeBench.Roth.Lower.V007.record record :=
  SqueezeBench.maxWith_strict (nMin := SqueezeBench.Roth.nMin) (n₀ := 2187) (by decide)
    (by decide +kernel)

end SqueezeBench.Roth.Lower.V008
