namespace SqueezeBench.ExC4.Upper.V005

-- The common denominator of the certificate weights.
def M : ℕ := 1048576

-- The weight of degree `i`: `0` below `k`, the listed levels from `k` on, the tail `g` after them.
def wt (k : ℕ) (ls : List ℕ) (g i : ℕ) : ℕ := if i < k then 0 else ls.getD (i - k) g

-- The scaled target `β` for the bound `B`, the largest with `nβ < 2M(B + 1)`, and the tail weight.
def betaOf (n B : ℕ) : ℕ := (2 * M * (B + 1) - 1) / n

def gOf (n B : ℕ) : ℕ := betaOf n B / (n - 1)

-- The largest offset a degree `i < T` may carry, and the condition that makes it well defined.
def dlow (n β i w : ℕ) : ℕ := (β + i * (w * (i - 1)) - (M * i + w * (n - 1 - i % 2))) / i

def d1ok (n β i w : ℕ) : Bool := M * i + w * (n - 1 - i % 2) ≤ β + i * (w * (i - 1))

-- The offset of degree `i`: computed below `T = k + |ls|`, linear in the tail.
def dl (n k : ℕ) (ls : List ℕ) (g β i : ℕ) : ℕ :=
  if i < k + ls.length then dlow n β i (wt k ls g i) else (i - 1) * g - M

-- The edge inequality for the degree pair `(i, j)`.
def d2ok (n k : ℕ) (ls : List ℕ) (g β i j : ℕ) : Bool :=
  wt k ls g i * (i - 1) + wt k ls g j * (j - 1)
    ≤ wt k ls g i * (j - 1) + wt k ls g j * (i - 1) + dl n k ls g β i + dl n k ls g β j

-- `p i` for every `i` with `lo ≤ i < lo + c`.
def allFrom (p : ℕ → Bool) (lo : ℕ) : ℕ → Bool
  | 0 => true
  | c + 1 => p (lo + c) && allFrom p lo c

-- The whole certificate check.
def certOk (n k : ℕ) (ls : List ℕ) (B : ℕ) : Bool :=
  let T := k + ls.length
  let β := betaOf n B
  let g := gOf n B
  (M ≤ (T - 1) * g) && (g * (n - 1) ≤ β) && (wt k ls g 0 * (n - 1) ≤ β)
    && allFrom (fun i => d1ok n β i (wt k ls g i)) 1 (T - 1)
    && allFrom (fun i => allFrom (fun j => d2ok n k ls g β i j) (i + 1) (T - i)) 1 (T - 1)

