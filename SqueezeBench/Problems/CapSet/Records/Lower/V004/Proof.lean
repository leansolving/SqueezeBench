-- ## The cap criterion of V003, packaged: a checked code list gives `length ≤ f n`.

theorem le_f_of_codes (n : ℕ) (codes : List ℕ) (M : ℕ) (hn : 1 ≤ n)
    (hlt : ∀ c ∈ codes, c < 3 ^ n) (hmem : ∀ c ∈ codes, M.testBit c = true)
    (hpair : ∀ x ∈ codes, M &&& V003.refl n x M = 1 <<< x)
    (hchain : List.IsChain (· < ·) codes) :
    codes.length ≤ SqueezeBench.CapSet.f n := by
  have hfree := V003.threeAPFree_of_mask n codes M hlt hmem hpair
  have h := SqueezeBench.CapSet.le_f_of_threeAPFree (A := (codes.map (V003.dec n)).toFinset)
    (by simpa using hn) hfree
  rwa [List.toFinset_card_of_nodup (List.Nodup.map_on
    (fun x hx y hy h => V003.dec_inj (hlt x hx) (hlt y hy) h)
    (hchain.pairwise.imp fun h => Nat.ne_of_lt h)), List.length_map] at h

