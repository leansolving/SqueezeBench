-- ## The dynamic programme: every product of table caps is a cap.

theorem tbl_valid : ∀ p ∈ tbl, p.2 ≤ SqueezeBench.CapSet.f p.1 := by
  intro p hp
  simp only [tbl, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact V001.f1
  · exact V001.f2
  · exact V001.f3
  · exact V001.f4
  · exact V002.f5
  · exact V003.f6
  · exact f7
  · exact f8
  · exact f9

theorem tbl_pos : ∀ p ∈ tbl, 1 ≤ p.1 := by decide

theorem dp_length : ∀ k, (dp k).length = k + 1
  | 0 => rfl
  | k + 1 => by simp [dp, dp_length k]

theorem best_succ (k : ℕ) : best (k + 1) = step (dp k) := by
  rw [best, dp, List.headD_cons]

theorem best_zero : best 0 = 1 := rfl

theorem dp_getD : ∀ k j, j ≤ k → (dp k).getD j 0 = best (k - j)
  | 0, 0, _ => rfl
  | 0, j + 1, h => by omega
  | k + 1, 0, _ => by rw [Nat.sub_zero, best_succ, dp, List.getD_cons_zero]
  | k + 1, j + 1, h => by
    rw [dp, List.getD_cons_succ, dp_getD k j (by omega), Nat.add_sub_add_right]

theorem dp_getD_of_gt (k j : ℕ) (h : k < j) : (dp k).getD j 0 = 0 :=
  List.getD_eq_default _ _ (by rw [dp_length]; omega)

theorem foldl_max_le {l : List (ℕ × ℕ)} {g : ℕ → ℕ} {B : ℕ}
    (h : ∀ p ∈ l, p.2 * g p.1 ≤ B) : ∀ acc, acc ≤ B →
      l.foldl (fun acc p => max acc (p.2 * g p.1)) acc ≤ B := by
  induction l with
  | nil => intro acc hacc; simpa using hacc
  | cons p l ih =>
    intro acc hacc
    simp only [List.foldl_cons]
    exact ih (fun q hq => h q (by simp [hq])) _ (max_le hacc (h p (by simp)))

theorem best_le : ∀ n, 1 ≤ n → best n ≤ SqueezeBench.CapSet.f n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
    rw [best_succ, step]
    refine foldl_max_le (g := fun d => (dp k).getD (d - 1) 0) ?_ 0 (Nat.zero_le _)
    intro p hp
    have hp1 := tbl_pos p hp
    have hpf := tbl_valid p hp
    show p.2 * (dp k).getD (p.1 - 1) 0 ≤ SqueezeBench.CapSet.f (k + 1)
    by_cases hd : p.1 ≤ k + 1
    · rw [dp_getD k (p.1 - 1) (by omega)]
      by_cases heq : p.1 = k + 1
      · rw [show k - (p.1 - 1) = 0 by omega, best_zero, mul_one, ← heq]
        exact hpf
      · have h1 : 1 ≤ k - (p.1 - 1) := by omega
        have hrec := ih (k - (p.1 - 1)) (by omega) h1
        calc p.2 * best (k - (p.1 - 1))
            ≤ SqueezeBench.CapSet.f p.1 * SqueezeBench.CapSet.f (k - (p.1 - 1)) :=
              Nat.mul_le_mul hpf hrec
          _ ≤ SqueezeBench.CapSet.f (p.1 + (k - (p.1 - 1))) := V001.f_mul_le _ _ hp1 h1
          _ = SqueezeBench.CapSet.f (k + 1) := by
              rw [show p.1 + (k - (p.1 - 1)) = k + 1 by omega]
    · rw [dp_getD_of_gt k (p.1 - 1) (by omega), mul_zero]
      exact Nat.zero_le _

theorem best_valid : SqueezeBench.LowerBoundHolds SqueezeBench.CapSet.f
    (SqueezeBench.pin SqueezeBench.CapSet.nMin best) :=
  SqueezeBench.pin_lowerBoundHolds fun n hn => best_le n (by simpa using hn)

theorem valid : SqueezeBench.LowerBoundHolds SqueezeBench.CapSet.f record :=
  SqueezeBench.maxWith_valid SqueezeBench.CapSet.Lower.V003.valid best_valid

theorem improves : SqueezeBench.ImprovesLower SqueezeBench.CapSet.Lower.V003.record record :=
  SqueezeBench.maxWith_improves

theorem strict :
    SqueezeBench.StrictlyImprovesLower SqueezeBench.CapSet.nMin SqueezeBench.CapSet.Lower.V003.record record :=
  SqueezeBench.maxWith_strict (nMin := SqueezeBench.CapSet.nMin) (n₀ := 8) (by decide)
    (by decide +kernel)

end SqueezeBench.CapSet.Lower.V004
